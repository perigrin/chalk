use 5.42.0;
use utf8;
use experimental 'class';
use Chalk::MOP::Field;
use Chalk::MOP::Method;
use Chalk::MOP::Sub;
use Chalk::MOP::Import;
use Chalk::MOP::Phaser::Adjust;
class Chalk::MOP::Class {
    field $name :param :reader;
    field $superclass :param :reader = undef;
    field $parent_name :param :reader = undef;
    field $mop :param :reader;
    field $is_class :param :reader = false;
    field @fields;
    field @methods;
    field @subs;
    field @imports;
    field @adjust_blocks;
    field @class_scope_vars;
    field @statements;
    field @use_constants;
    field $sealed = false;
    field @unloaded;
    field $symbols;
    field $symbols_unknown = {};
    method is_sealed() {
        return $sealed;
    }
    method seal() {
        $sealed = true;
        return;
    }
    method _assert_unsealed($what) {
        if ($sealed) {
            die "Chalk::MOP::Class: $what on sealed class '$name' -- " . 'construction ended at seal()';
        }
        return;
    }
    method fields() {
        return @fields;
    }
    method methods() {
        return @methods;
    }
    method subs() {
        return @subs;
    }
    method imports() {
        return @imports;
    }
    method adjust_blocks() {
        return @adjust_blocks;
    }
    method class_scope_vars() {
        return @class_scope_vars;
    }
    method statements() {
        return @statements;
    }
    method use_constants() {
        return @use_constants;
    }
    method unloaded() {
        return @unloaded;
    }
    method declare_unloaded($sub_name) {
        $self->_assert_unsealed('declare_unloaded');
        push @unloaded, $sub_name;
        return;
    }
    method knows_symbols() {
        return defined($symbols) ? true : false;
    }
    method declare_symbols($table, $unknown) {
        $self->_assert_unsealed('declare_symbols');
        my %t;
        for my $n (keys($table->%*)) {
            $t{$n} = $table->{$n};
        }
        $symbols = \%t;
        my %u;
        for my $n ($unknown->@*) {
            $u{$n} = 1;
        }
        $symbols_unknown = \%u;
        return;
    }
    method has_symbol($n) {
        if (!(defined($symbols) && !$symbols_unknown->{$n})) {
            return undef;
        }
        return exists($symbols->{$n}) ? 1 : 0;
    }
    method symbol($n) {
        return defined($symbols) ? $symbols->{$n} : undef;
    }
    method symbol_names() {
        return defined($symbols) ? sort(keys($symbols->%*)) : ();
    }
    method symbols_unknown() {
        return sort(keys($symbols_unknown->%*));
    }
    method EXISTS($key) {
        my $has = $self->has_symbol($key);
        if (defined($has)) {
            return $has;
        }
        return _refuse("whether ${name}:: holds $key (its presence is not known: the toolchain made it, or no symbol table was given)");
    }
    method FETCH($key) {
        my $has = $self->has_symbol($key);
        if (defined($has)) {
            return $has ? 1 : undef;
        }
        return _refuse("whether ${name}:: holds $key (its presence is not known: the toolchain made it, or no symbol table was given)");
    }
    method STORE($key, $value) {
        return _refuse("a store into the stash ${name}:: (a change to the MOP at run time)");
    }
    method DELETE($key) {
        return _refuse("a delete from the stash ${name}:: (a change to the MOP at run time)");
    }
    method CLEAR() {
        return _refuse("the stash ${name}:: emptied or assigned whole (a change to the MOP at run time)");
    }
    method FIRSTKEY() {
        return _refuse("the keys of the stash ${name}:: (perl's own names in it are not all known)");
    }
    method NEXTKEY($last) {
        return _refuse("the keys of the stash ${name}:: (perl's own names in it are not all known)");
    }
    method declare_field($field_name, %opts) {
        $self->_assert_unsealed('declare_field');
        my $field = 'Chalk::MOP::Field'->new('name', $field_name, 'class', $self, 'fieldix', scalar(@fields), %opts);
        push @fields, $field;
        return $field;
    }
    method declare_method($method_name, %opts) {
        $self->_assert_unsealed('declare_method');
        my $method = 'Chalk::MOP::Method'->new('name', $method_name, 'class', $self, %opts);
        push @methods, $method;
        return $method;
    }
    method declare_sub($sub_name, %opts) {
        $self->_assert_unsealed('declare_sub');
        my $sub = 'Chalk::MOP::Sub'->new('name', $sub_name, 'class', $self, %opts);
        push @subs, $sub;
        return $sub;
    }
    method declare_import($module, %opts) {
        $self->_assert_unsealed('declare_import');
        my $kw = $opts{'keyword'} // 'use';
        for my $existing (@imports) {
            if ($existing->module() eq $module && ($existing->keyword() // 'use') eq $kw) {
                return $existing;
            }
        }
        my $import = 'Chalk::MOP::Import'->new('module', $module, 'class', $self, %opts);
        push @imports, $import;
        return $import;
    }
    method declare_adjust(%opts) {
        $self->_assert_unsealed('declare_adjust');
        my $adjust = 'Chalk::MOP::Phaser::Adjust'->new('class', $self, 'source_position', scalar(@adjust_blocks), %opts);
        push @adjust_blocks, $adjust;
        return $adjust;
    }
    method declare_class_scope_var($vardecl_node) {
        $self->_assert_unsealed('declare_class_scope_var');
        push @class_scope_vars, $vardecl_node;
        return $vardecl_node;
    }
    method declare_statement($node) {
        $self->_assert_unsealed('declare_statement');
        push @statements, $node;
        return $node;
    }
    method declare_use_constant($name, $value_node) {
        $self->_assert_unsealed('declare_use_constant');
        my $entry = { 'name', $name, 'value', $value_node };
        push @use_constants, $entry;
        return $entry;
    }
    method find_method($search_name) {
        for my $m (@methods) {
            if ($m->name() eq $search_name) {
                return $m;
            }
        }
        if (defined($superclass)) {
            return $superclass->find_method($search_name);
        }
        return;
    }
    method ancestors() {
        my @chain;
        my $current = $superclass;
        while (defined($current)) {
            push @chain, $current;
            $current = $current->superclass();
        }
        return @chain;
    }
    method all_nodes() {
        my @nodes;
        for my $owner (@methods, @subs) {
            next unless $owner->can('graph');
            my $g = $owner->graph();
            next unless defined($g);
            push @nodes, $g->nodes()->@*;
        }
        return @nodes;
    }
    method resolve_adjust_blocks() {
        my @result;
        my @ancestor_chain = reverse($self->ancestors());
        for my $cls (@ancestor_chain) {
            push @result, $cls->adjust_blocks();
        }
        push @result, @adjust_blocks;
        return @result;
    }
    sub _refuse($why) {
        print STDERR "chalk: refused at run time: $why\n";
        exit(255);
    }
}
