# ABOUTME: Phase 4 gate measurement: run EVERY mdtest corpus case through B::SoN.
# ABOUTME: Triple contract per case: behavior (lli == perl) + shape (ir-block subset) + TypedInvariant.
use 5.42.0;
use utf8;
use Test::More;
use JSON::PP;
use File::Temp qw(tempfile);

use lib 'lib', 't/lib';
use Chalk::IR::Serialize::JSON ();
use Chalk::IR::Graph::TypedInvariant;
use Chalk::Target::LLVM;
use Chalk::CodeGen::Harness::MdtestCorpus;
use Chalk::CodeGen::Pipeline;

my $PERL = "$ENV{HOME}/.local/share/pvm/versions/5.42.0/bin/perl";
my $SON  = $ENV{PERL5_SON_LIB} // "$ENV{HOME}/dev/perl5-son/lib";
my $LLI  = '/usr/lib/llvm-15/bin/lli';

plan skip_all => "perl5-son not found at $SON" unless -f "$SON/B/SoN.pm";
plan skip_all => "lli not found at $LLI"        unless -x $LLI;
plan skip_all => "perl 5.42 not found at $PERL" unless -x $PERL;

# host.md H3 ($ENV{CHALK_G7_TEST}) declares its env dependency in the case
# prose: both the perl oracle and lli inherit this runner's environment (they
# are qx() child processes). Set it so H3 gate-greens here as it does in the
# dedicated host.t runner (which sets the same var).
local $ENV{CHALK_G7_TEST} = 'hostval';

# ---------------------------------------------------------------------------
# The B::SoN pipeline (class-aware), reused shape from son-e2e.t.
# ---------------------------------------------------------------------------
sub split_class_source ($clean) {
    my @lines = split /\n/, $clean;
    my (@head, @driver, @class_names);
    my ($depth, $in_class) = (0, 0);
    for my $line (@lines) {
        if (!$in_class && $line =~ /^\s*(?:use|no)\s+/) { push @head, $line; next; }
        if (!$in_class && $line =~ /^\s*class\s+(\w[\w:]*)/) {
            push @class_names, $1; $in_class = 1; $depth = 0;
        }
        if ($in_class) {
            push @head, $line;
            $depth += ($line =~ tr/{//);
            $depth -= ($line =~ tr/}//);
            $in_class = 0 if $depth <= 0;
            next;
        }
        push @driver, $line;
    }
    # The driver body is the PROGRAM's top level, not a sub body. The old
    # `sub corpus_case { ... }` wrap supplied a VALUE CONTEXT that a real
    # program does not have — perl discards a bare trailing expression in void
    # context — so the corpus was measuring a different contract from the
    # executable one every other gate uses.
    my $prog = join("\n", @head) . "\npackage main;\n"
             . join("\n", @driver) . "\n";
    return ($prog, \@class_names);
}

sub run_through_bson ($source) {
    (my $clean = $source) =~ s/^\s*#[^\n]*\n//gm;
    $clean =~ s/\s+$//;
    my ($prog, $class_names) = split_class_source($clean);
    my $pkg_opts = join(',', 'package=main', map { "package=$_" } @$class_names);

    my ($fh, $tmp) = tempfile(SUFFIX => '.pl', UNLINK => 1);
    print $fh $prog;
    close $fh;

    my $json = qx($PERL -I$SON -MO=SoN,json,$pkg_opts $tmp 2>/dev/null);
    return (undef, "B::SoN produced no JSON")        unless $json =~ /\S/;
    my $data = eval { JSON::PP->new->decode($json) };
    return (undef, "JSON decode failed")             unless $data;
    return (undef, "no entry graph: a bare file produced no top-level graph")
        unless $data->{methods}{'main::__PROGRAM__'}
            || $data->{methods}{'main::__main__'};

    # Load and lower the entry unit through the ONE pipeline seam.
    #
    # A program states its own output: this graph prints exactly what its Print
    # nodes print. The Int:/Str: return-value epilogue that fragment harnesses
    # once read a value back through is gone, and `program_mode` — the flag that
    # suppressed it — is inert. Harnesses that need to observe a return value
    # now WRAP the graph in a Print (see Mode2Adapter::_print_returned_value).
    my $select = sub ($graphs, $mop) {
        my $g = $graphs->{'main::__PROGRAM__'} // $graphs->{'main::__main__'}
            or return ();
        my $ret = $g->returns->[0] or return ();
        return ([ 'main::__PROGRAM__', $ret ]);
    };

    my ($units, $graphs, undef, $load_err) = Chalk::CodeGen::Pipeline->new
        ->run_detail($json, $select, program_mode => 1);
    return (undef, $load_err) if $load_err;

    my $g = $graphs->{'main::__PROGRAM__'} // $graphs->{'main::__main__'}
        or return (undef, "no loaded graph");
    return (undef, "no Return node", $g) unless @$units;
    my $unit = $units->[0];
    return (undef, "lower: $unit->{err}", $g) unless $unit->{ok};
    my $ll = $unit->{ll};

    my ($lfh, $lltmp) = tempfile(SUFFIX => '.ll', UNLINK => 1);
    print $lfh $ll; close $lfh;

    # STDERR captured separately, matching the perl oracle. On the success path
    # an lli diagnostic would otherwise be indistinguishable from the program's
    # own output; on a failure path it is the useful part of the report, so the
    # error branches below surface it rather than discarding it.
    my ($elfh, $eltmp) = tempfile(SUFFIX => '.err', UNLINK => 1);
    close $elfh;
    my $out = qx($LLI $lltmp 2>$eltmp);
    my $lli_err = sub {
        my $e = do { local (@ARGV, $/) = ($eltmp); <> } // '';
        $e =~ s/\s+\z//;
        return $e;
    };
    if (my $sig = $? & 127) {
        return (undef, "lli died on signal $sig: " . $lli_err->(), $g);
    }
    # A NONZERO EXIT IS A RESULT, NOT A FAILURE TO LOWER. `exit 4` and `die`
    # are how a perl program sets its status, so folding them into "did not
    # lower" makes a wrong exit status unobservable -- and makes a CORRECT one
    # unrepresentable. This read any nonzero exit as a compile failure until a
    # case (T14/T15) finally exercised it. The status is compared against
    # perl's alongside stdout, the same contract ProgramRunner uses.
    my $exit = $? >> 8;
    chomp $out;
    return ($out, undef, $g, $exit);
}

sub perl_oracle ($source) {
    (my $clean = $source) =~ s/^\s*#[^\n]*\n//gm;
    $clean =~ s/\s+$//;
    # The case IS the program: no `do { }` wrapper and no type-tag epilogue. A
    # case states its own output with say/print, exactly as the chalk side runs
    # it. The wrapper supplied a value context a program's top level lacks, so
    # the two sides were being asked different questions.
    my $prog = $clean;
    my ($fh, $tmp) = tempfile(SUFFIX => '.pl', UNLINK => 1);
    binmode $fh, ':utf8';
    print $fh $prog; close $fh;

    # STDERR is captured SEPARATELY, not folded into the comparison. Perl's
    # warnings are not program output: `say $a[9]` on an out-of-bounds read
    # prints an empty line AND warns "Use of uninitialized value in say". Chalk
    # emits no warnings, so folding stderr in made any warning-producing case
    # impossible to match, and reported it as a behaviour divergence when the
    # lowering was correct.
    #
    # A genuine oracle FAILURE must still be loud, though: dropping stderr
    # outright would let a case whose perl side dies compare empty-to-empty and
    # read as a pass. So a nonzero exit returns the diagnostic as the result,
    # which cannot match any lli output.
    my ($efh, $etmp) = tempfile(SUFFIX => '.err', UNLINK => 1);
    close $efh;
    my $out  = qx($PERL $tmp 2>$etmp);
    my $exit = $? >> 8;
    # Whether the program WROTE ANYTHING, judged before the chomp. `say(!$a)`
    # for a true $a prints a bare newline — real output that chomps to "" and
    # would otherwise be indistinguishable from a program that printed nothing
    # at all. The non-vacuity check needs the difference.
    my $wrote = length($out) ? 1 : 0;
    chomp $out;
    # A nonzero status is part of the ANSWER (`exit 4`, `die`), so it is
    # returned for comparison rather than turned into a diagnostic string. A
    # case whose oracle dies unexpectedly is still caught: its status is
    # compared against lli's, and its stdout against lli's stdout.
    return ($out, $wrote, $exit);
}

# ---------------------------------------------------------------------------
# Iterate every case in every topic file.
# ---------------------------------------------------------------------------
my @topics = sort glob('t/corpus/mdtest/*.md');

my %tally = (green => 0, gap_declared => 0, bug => 0, no_source => 0,
             shape_ok => 0, inv_ok => 0, gate_green => 0, todo => 0);
my %by_topic;
my @bugs;

for my $md (@topics) {
    my $topic = $md =~ m{/([^/]+)\.md$} ? $1 : $md;
    my $cases = Chalk::CodeGen::Harness::MdtestCorpus->parse_file($md);

    for my $case (@$cases) {
        my $title  = $case->{title} // '?';
        my $source = $case->{source};
        my $label  = "$topic: $title";

        unless (defined $source && $source =~ /\S/) {
            $tally{no_source}++;
            next;   # section with no perl block (prose)
        }

        my $verdict = Chalk::CodeGen::Harness::MdtestCorpus
            ->parse_l_verdict_from_ir($case->{ir} // '');

        # A case with NO ir block, and one whose ir block is pure-GAP, are both
        # WORK WE INTEND TO DO rather than a check that does not apply here.
        # The shape and invariant legs now say TODO for them (they used to say
        # SKIP, and the shape leg said PASS for a pure-GAP block -- absence
        # rendered as success). Counted here, at the classification point,
        # because a pure-GAP case short-circuits below before any leg runs.
        $tally{todo}++
            if !(defined $case->{ir} && $case->{ir} =~ /\S/)
            || Chalk::CodeGen::Harness::MdtestCorpus::_is_pure_gap_block($case->{ir});

        # Corpus-declared GAP: not expected to lower; record honestly.
        if ($verdict eq 'GAP') {
            $tally{gap_declared}++;
            $by_topic{$topic}{gap}++;
            pass("$label: corpus-declared GAP (skipped)");
            next;
        }

        my ($oracle, $oracle_wrote, $oracle_exit) = perl_oracle($source);
        my ($lli, $err, $g, $lli_exit) = run_through_bson($source);

        # NON-VACUITY. Now that a case runs as a PROGRAM, one that prints
        # nothing compares empty-to-empty and reads as a pass — which is
        # exactly what an UNMIGRATED case looks like, since a program's top
        # level discards a bare trailing expression in void context. Measured
        # on `my $a = 3; $a + 1`: PASS, both sides empty, nothing verified.
        #
        # Judged on whether the oracle WROTE BYTES, not on whether the chomped
        # result is non-blank: `say(!$a)` for a true $a prints a bare newline,
        # which is real output that chomps to "". Testing the chomped string
        # would mark that case vacuous and demand it be rewritten, which would
        # be this check inventing work rather than finding it.
        my $vacuous = !$oracle_wrote;
        $err //= 'vacuous: the perl oracle WROTE NOTHING, so this case '
               . 'compares empty-to-empty and verifies nothing (an unmigrated '
               . 'case: say/print the value)'
            if $vacuous;

        # The triple contract (Phase 4 gate): behavior AND shape AND invariant.
        # Behaviour is stdout AND EXIT STATUS -- a program's whole observable
        # contract. Comparing stdout alone made `exit 4` indistinguishable from
        # `exit 0`.
        my $status_ok   = ($lli_exit // 0) == ($oracle_exit // 0);
        my $behavior_ok = !$vacuous && defined $lli && $lli eq $oracle
                          && $status_ok;
        $err //= "exit status: perl $oracle_exit vs lli $lli_exit"
            if defined $lli && !$status_ok;

        my ($shape_ok, $shape_why) = (0, 'no loaded graph');
        my ($inv_ok,   $inv_why)   = (0, 'no loaded graph');
        if (defined $g) {
            # Each leg is exception-isolated: a die in one graph walk must
            # cost that case only, not abort the whole gap map.
            my $shape = eval {
                Chalk::CodeGen::Harness::MdtestCorpus
                    ->shape_subset_check($case->{ir}, $g->returns->[0]);
            } // { verdict => 'FAIL', missing => [], reason => "died: $@" };
            $shape_ok  = $shape->{verdict} eq 'PASS';
            $shape_why = $shape->{verdict} eq 'FAIL' && $shape->{missing}->@*
                ? 'missing [' . join(', ', $shape->{missing}->@*) . ']'
                : ($shape->{reason} // '');

            my $inv = eval { Chalk::IR::Graph::TypedInvariant->check($g) }
                // { ok => 0, violations => [{ message => "died: $@" }] };
            $inv_ok  = $inv->{ok} ? 1 : 0;
            $inv_why = $inv->{ok} ? ''
                : join('; ', map { $_->{message} } $inv->{violations}->@*);

            # The invariant above checks the PRODUCER's graph. The ir block
            # describes a DIFFERENT graph, and nothing checked that one -- so a
            # spec could assert a shape the IR forbids and stay green. Measured
            # on D1f: deleting its `predecessors:` line kept all three legs
            # green, and so did swapping it to [%proj1, %proj0], an inverted arm
            # pairing (the defect class of 44d1fa8c / 9ce43cdd).
            #
            # Folded into the invariant leg rather than added as a fourth: both
            # ask "is this a legal graph", and a case is not gate-green if
            # either the code it compiles to or the shape it documents is
            # illegal. SKIP (GAP block, unbuildable) leaves the verdict alone --
            # unbuildability is the shape leg's finding to report.
            if ($inv_ok) {
                my $spec_inv = eval {
                    Chalk::CodeGen::Harness::MdtestCorpus
                        ->spec_invariant_check($case->{ir});
                } // { verdict => 'FAIL', reason => "died: $@" };
                if ($spec_inv->{verdict} eq 'FAIL') {
                    $inv_ok  = 0;
                    $inv_why = 'ir block: ' . ($spec_inv->{reason} // '');
                }
            }
        }

        $tally{green}++,      $by_topic{$topic}{green}++      if $behavior_ok;
        $tally{shape_ok}++,   $by_topic{$topic}{shape}++      if $shape_ok;
        $tally{inv_ok}++,     $by_topic{$topic}{inv}++        if $inv_ok;

        if ($behavior_ok && $shape_ok && $inv_ok) {
            $tally{gate_green}++;
            $by_topic{$topic}{gate}++;
            pass("$label: gate-green (behavior + shape + invariant)");
        }
        else {
            my @why;
            push @why, (defined $lli ? "lli '$lli' != perl '$oracle'" : $err)
                unless $behavior_ok;
            push @why, "shape: $shape_why"     unless $shape_ok;
            push @why, "invariant: $inv_why"   unless $inv_ok;
            my $why = join(' | ', @why);
            $tally{bug}++;
            $by_topic{$topic}{bug}++;
            push @bugs, "$label -> $why";
            # Not a test failure: this is the gap map. Mark TODO so red = worklist.
            TODO: {
                local $TODO = "B::SoN gap (worklist, not a regression)";
                fail("$label: $why");
            }
        }
    }
}

# ---------------------------------------------------------------------------
# The map.
# ---------------------------------------------------------------------------
diag("");
diag("=== Phase 4 corpus-wide status (triple contract: behavior+shape+invariant) ===");
for my $t (sort keys %by_topic) {
    my $b = $by_topic{$t};
    diag(sprintf("  %-14s gate=%-2d behavior=%-2d shape=%-2d inv=%-2d gap=%-2d worklist=%-2d",
        $t, $b->{gate} // 0, $b->{green} // 0, $b->{shape} // 0,
        $b->{inv} // 0, $b->{gap} // 0, $b->{bug} // 0));
}
diag("");
diag(sprintf(
    "TOTAL: gate-green=%d  behavior=%d  shape=%d  invariant=%d  gap-declared=%d  todo=%d  worklist=%d  (no-source sections=%d)",
    @tally{qw(gate_green green shape_ok inv_ok gap_declared todo bug no_source)}));
if (@bugs) {
    diag("");
    diag("=== worklist (triple-contract gaps to close) ===");
    diag("  $_") for @bugs;
}

# The gate floor: the worklist is TODO (red = worklist, not regression), but
# already-certified gate-green cases must never silently regress. Raise the
# floor as the shape-contract families (019f2a50 pair) land.
cmp_ok($tally{gate_green}, q{>=}, 215, q{gate-green floor (215; LOWERED FROM 218 BY D2 (perigrin, 2026-08-26): the Undef drop is deleted, so an Undef arm enters the join and logical.md L3b/L3c/L3d merge to Scalar, which has no machine encoding until T2 exists. All three are DECLARED GAPs naming Scalar. 215 is a CEILING as well as a floor while it stands -- a FOURTH case GAPping here is a regression, not more of the same. Restoring 218 is T2 acceptance criteria; T2 is not done while this reads 215. See spec 9.5. PRIOR HISTORY OF THIS FLOOR: THE CALLEE GRAPH IS ONE OBJECT SHARED BY EVERY CALL SITE, and the value cache was keyed on node id. Measured: in `f(1)+f(2)` both Call#2 and Call#3 hold the SAME callee graph refaddr, and that graph's Multiply node has a single id and a single refaddr -- so the first inline cached the callee's body and the second site was served site 1's result with site 1's ARGUMENT baked in. The emitted LLVM contained exactly ONE `mul` for two calls: F14 printed 4 where perl prints 6, F15 printed 2 where perl prints 4, F16 printed `2 2` where perl prints `2 4`. THREE separate corpus cases because the defect is reachable three ways and a narrower fix closes only some: F14 two calls in one expression, F15 the same call NESTED in its own argument (an argument-binding fix could plausibly close F14 and not this), F16 two calls in SEPARATE STATEMENTS (a fix scoped to one expression tree does not close it). FIX (Chalk-only, _lower_call_direct): snapshot the cache before the inline and restore it after, so callee entries do not outlive the frame -- mirroring the local-scoped _arg_bind frame immediately above it. refaddr keying does NOT fix this, unlike _arg_bind's own collision: there the keys were per-node and merely needed to be unique across graphs, whereas here the callee node objects are LITERALLY IDENTICAL between sites, so the FRAME is what the scoping must follow. Snapshot-and-restore rather than a fresh empty cache, because the caller's already-lowered nodes must stay visible to the inlined body (its arg refs were lowered in the caller's context). The caller-side memo under the Call's own id is written AFTER the restore -- it must survive. `f(3)+f(3)` passed against the live defect by COINCIDENCE (one cached computation is right for both sites), which is why all three cases insist the arguments DIFFER. THE SHAPE LEG COULD NEVER HAVE CAUGHT THIS: the graph was correct all along -- two distinct Call nodes with distinct arguments -- and only the LOWERING collapsed them, so behavior was the only leg that could see it. Both F14 and F15 ir blocks were also rewritten from MEASURED output: they had expected a folded `Constant(6)`/`Constant(4)`, which nothing produces (the producer does not constant-fold across a call, and Print takes its operands directly rather than through a Concat). worklist 3 -> 0, and all four legs agree for the first time. 215; S7 pins a PVMG constant-decode defect class -- a v-string is a POK-only PVMG whose isa(B::IV) is true, so a class-ordered decode chain returned its empty integer slot and the program printed 0 where perl prints AB, with NO GAP. The decode is now FLAGS-driven, IOK/NOK before POK so a stringified number stays a number and POK-alone means Str. The case must print the CONTENT: print length(v1.2.3) folds to const[IV 3] before B::SoN sees an SV, so it passes against the live defect. 214; T16-T20 lift the nested ONE-ARMED if refusal, and the message it refused under named the wrong shape. Perl compiles a one-armed `if` and a statement MODIFIER to the SAME `and` op, so a refusal written for `print "hi" if C` inside an arm also fired on plain nested blocks -- and on every `elsif`, which is ordinary code rather than a modifier idiom and is named as a blocker by two other corpus cases. DEPTH IS NOT THE DISCRIMINATOR, measured in both directions: a four-deep nest where every level is two-armed already lowered, while a two-deep nest with a one-armed inner if did not. The discriminator is one-armed-ness PLUS a void effect. UNLIKE the three refusals lifted earlier this week, this one was SOUND -- an unbuilt path, not an expired premise -- so this is a build, not a lift. What it builds is not new: the main walk's &&/|| handler already constructs exactly this (If + Proj(body)/Proj(continue) before the arm walk, effect emitted on its own Proj, merge() Regioning after) for the same op in the same context, 3900 lines above the refusal. The nested handler now does the same. A SECOND defect surfaced only once that was built: the arm SCANS bail at a nested branch (correct -- descending would attribute an effect to the wrong arm for value purposes), so the OUTER branch saw no effect and took the value-merge path while the inner built control flow beneath it. The inner guard was swallowed -- ONE If for two source-level ifs -- and its effect fired unguarded: `if(C){if(C){print}}` printed NOTHING, and a nested die exited 0 where perl exited 255. The scans now DESCEND for the needs-control-flow question only, which is arm-independent, sharing ONE seen-set across the recursion -- a per-call set recursed forever on real branchy code (Deep recursion, then a Killed process, caught by t/b-son-backend.t). TWO SHAPES STAY REFUSED, and both were found by tests asserting a GAP that had stopped firing -- each verified BEHAVIOURALLY before being believed rather than updated: an ELEMENT STORE (routing it through dropped the store silently -- `if($c){if($d){$a[0]=9}} $a[0]` printed 1 where perl printed 9, and BOTH guard polarities printed the same thing, needs the memory-Phi merge this handler does not build) and a void CALL (a Call is both a value and an effect and was emitted on BOTH paths -- "helped" printed twice where perl printed it once; that is the Call classification problem, not this handler's). A GAP is recoverable; a wrong answer is not. Five cases: T16 the target shape, T17 its bilateral partner (inner guard false -- a build that paired the merge arms bac