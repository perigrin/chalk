          "    sub bl(\$x, \$n, \$r) { return \"a\${\\ uc \$x}b|\@{[ \$n + 1 ]}|\${ \$r }|\@{[ \$n, \$n * 2 ]}|\${\\(\$x =~ s/a/z/r)}\" }\n",
          "}\n"),
      q{print RT32::bl('ab', 2, \'R'), "\n";} ],
    [ 'undef in a list declaration skips a value',
      join('', "class RT33 {\n",
          "    sub sk(\@in) { my (undef, \$b, undef, \$d) = \@in; return \"\$b\$d\" }\n",
          "}\n"),
      q{print RT33::sk(1, 2, 3, 4), "\n";} ],
    [ 'return of a parenthesized list returns the list',
      join('', "class RT35 {\n",
          "    sub two() { return (1, 2) }\n",
          "    sub three(\$x) { return ('a', \$x, 'c') }\n",
          "    sub bare() { return 4, 5 }\n",
          "}\n"),
      q{my @a = RT35::two(); my @b = RT35::three('b'); my @c = RT35::bare(); my $s = RT35::two(); print join(',', @a, '|', @b, '|', @c, '|', $s), "\n";} ],
    [ 'a list assignment to elements stores each element',
      join('', "class RT34 {\n",
          "    sub el(\$o) {\n",
          "        my %h;\n",
          "        my \$x;\n",
          "        ( \$h{a}, \$h{b} ) = ( 1, 2 );\n",
          "        ( \$o->{cur}, undef, \$x ) = ( 3, 4, 5 );\n",
          "        ( \$o->{m}, \$o->{n} ) = pair();\n",
          "        return \"\$h{a}\$h{b}\$o->{cur}\$x\$o->{m}\$o->{n}\";\n",
          "    }\n",
          "    sub pair() { return ( 'p', 'q' ) }\n",
          "}\n"),
      q{print RT34::el({}), "\n";} ],
    [ 'undef EXPR on a scalar makes it undef',
      join('', "class RT36 {\n",
          "    sub u(\$x) { my \$y = \$x; undef \$y; my \$z = 3; undef(\$z); return (defined \$y ? 'd' : 'u') . (defined \$z ? 'd' : 'u') . \$x }\n",
          "}\n"),
      q{print RT36::u(7), "\n";} ],
    [ 'a declaration from a parenthesized list builds the array, the hash, or the last value',
      join('', "class RT37 {\n",
          "    sub l() { my \@x = (1, 2); my %h = (a => 1, b => 2); my \$s = (4, 5); return join(',', scalar(\@x), \@x, \$h{a}, \$h{b}, \$s) }\n",
          "}\n"),
      q{print RT37::l(), "\n";} ],
    [ 'a builtin that takes no arguments is a term: time - 1 subtracts',
      join('', "class RT38 {\n",
          "    sub t() { my \$t = time - 1; my \$w = wantarray ? 1 : 0; return (\$t < time ? 'before' : 'not') . \$w }\n",
          "}\n"),
      q{my $s = RT38::t(); print $s, "\n";} ],
    [ 'map in an array constructor takes the whole list',
      join('', "class RT39 {\n",
          "    sub m() { my \$a = [ map { \$_ * 2 } 1, 2 ]; return join(',', \$a->\@*) }\n",
          "}\n"),
      q{print RT39::m(), "\n";} ],
    [ 'an element of @_ or of @x is not an element through $_ or $x',
      join('', "class RT40 {\n",
          "    sub g { return 'hi ' . \$_[0] . \$_[1] }\n",
          "    sub x() { my \@x = (5); my \$x = [6]; my %h = (k => 7); my \$h = { k => 8 }; return \$x[0] . \$x->[0] . \$h{k} . \$h->{k} }\n",
          "}\n"),
      q{print RT40::g('a', 'b'), '|', RT40::x(), "\n";} ],
    [ 'a statement modifier over a comma expression guards both operands',
      join('', "class RT17 {\n",
          "    sub g(\$x, \$i) {\n",
          "        my %by = (S => { op => 'T' });\n",
          "        ( \$x = \$by{\$i} // {} ), \$i = \$x->{op} // ''\n",
          "            if \$i eq 'S';\n",
          "        return \$i;\n",
          "    }\n",
          "}\n"),
      q{print RT17::g(undef, 'S'), RT17::g(undef, 'Q'), "\n";} ],
);

for my $case (@cases) {
    my ($name, $body, $driver) = $case->@*;
    state $n = 0;
    $n++;
    my $source = $HEAD . $body;
    my $code = emit($source);
    ok(defined $code, "$name: emits") or next;
    my $want = run_perl("orig$n", $source, $driver);
    my $got  = run_perl("emit$n", $code, $driver);
    is($got, $want, "$name: the emission behaves as the source")
        or diag("emitted:\n$code");
}

# What the target does not emit it refuses by name, never drops.
my @refusals = (
    [ 'a statement outside a class',
      "my \$count = 3;\nprint \"\$count\\n\";\nclass RTR1 {\n    sub f() { 1 }\n}\n",
      qr/GAP: a statement outside a class/ ],
    [ '__FILE__ and __LINE__, which name the emitted file',
      "class RTR2 {\n    sub f() { return __FILE__ . __LINE__ }\n}\n",
      qr/GAP: __FILE__/ ],
);
for my $case (@refusals) {
    my ($name, $body, $want) = $case->@*;
    my $code = eval { emit($HEAD . $body) };
    like($@, $want, "$name: refused by name")
        or diag("emitted:\n" . ($code // '(nothing)'));
}

done_testing();
