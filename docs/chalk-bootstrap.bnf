# ============================================================================
# Chalk::Bootstrap Perl 5.42.0 Subset Grammar
# ============================================================================
#
# FORMAT: Chalk::Bootstrap BNF (::= rules, ; terminators, /regex/ terminals)
# SPEC:   docs/chalk-grammar-spec.md
#
# This grammar is intentionally ambiguous. Disambiguation is delegated to
# semirings (Precedence, Arity/TypeInference, Structural) not grammar
# structure. 63 rules, ~70-75 after quantifier desugaring.
#
# ============================================================================

# §1  WHITESPACE
# _ is optional (zero or more), WS is required (one or more)

_ ::= /(?:\s|#[^\n]*)*/ ;

WS ::= /(?:\s|#[^\n]*)+/ ;

# §2  PROGRAM STRUCTURE

Program ::= _ StatementList? _ ;

StatementList ::= StatementItem
    | StatementList _ StatementItem ;

StatementItem ::= SimpleStatement _ /;/
    | CompoundStatement
    | /;/ ;

# §3  STATEMENT CATEGORIES

SimpleStatement ::= ReturnStatement WS PostfixModifier
    | ReturnStatement
    | ExpressionStatement
    | UseDeclaration
    | ExpressionStatement WS PostfixModifier ;

ReturnStatement ::= /return\b/ WS Expression
    | /return\b/ ;

CompoundStatement ::= Block
    | IfStatement
    | WhileStatement
    | ForStatement
    | ForeachStatement
    | ClassBlock
    | SubroutineDefinition
    | MethodDefinition
    | AdjustBlock
    | PhaserBlock
    | TryCatchStatement
    | LoopLabel _ WhileStatement
    | LoopLabel _ ForStatement
    | LoopLabel _ ForeachStatement
    | LoopLabel _ Block ;

# `LABEL:` before a loop or a bare block, the name next/last/redo LABEL
# jump to. One token, colon included: not the head of `Foo::Bar`.
LoopLabel ::= /[a-zA-Z_]\w*\s*:(?!:)/ ;

# §4  EXPRESSION STATEMENTS

# A modified statement is SimpleStatement's: the statement completes before
# its modifier, as `return` does, so nothing about the expression's own
# operators is carried past it.
ExpressionStatement ::= Expression
    | ExpressionList ;

PostfixModifier ::= /(?:if|unless|while|until|for|foreach)\b/ WS Expression ;

# §5  CONDITIONALS

IfStatement ::= /(?:if|unless)\b/ _ ParenExpr _ Block ElsifChain? ;

ElsifChain ::= _ /elsif\b/ _ ParenExpr _ Block ElsifChain?
    | _ /else\b/ _ Block ;

# §6  LOOPS

WhileStatement ::= /(?:while|until)\b/ _ ParenExpr _ Block ;

ForStatement ::= /for\b/ _ /\(/ _ Expression? _ /;/ _ Expression? _ /;/
    _ Expression? _ /\)/ _ Block ;

ForeachStatement ::= /(?:for|foreach)\b/ WS IteratorVariable _ ParenExpr _ Block
    | /(?:for|foreach)\b/ _ ParenExpr _ Block ;

IteratorVariable ::= /my\b/ WS ScalarVariable
    | ScalarVariable ;

# §7  USE DECLARATIONS

UseDeclaration ::= /(?:use|no)\b/ WS ModuleName
    | /(?:use|no)\b/ WS ModuleName WS ImportList ;

ModuleName ::= QualifiedIdentifier
    | Version
    | QualifiedIdentifier WS Version ;

ImportList ::= ExpressionList ;

# §8  VARIABLE DECLARATIONS

VariableDeclaration ::= /(?:my|our|state|local|field)\b/ WS Variable AttributeList?
    | /(?:my|our|state|local|field)\b/ WS /\(/ _ VariableList _ /\)/ ;

VariableList ::= Variable
    | VariableList _ /,/ _ Variable ;

# §9  DEFINITIONS

ClassBlock ::= /class\b/ WS QualifiedIdentifier AttributeList? _ Block ;

SubroutineDefinition ::= /sub\b/ WS QualifiedIdentifier _ Signature? _ Block
    | /(?:my|our|state)\b/ WS /sub\b/ WS QualifiedIdentifier _ Signature? _ Block ;

MethodDefinition ::= /method\b/ WS QualifiedIdentifier AttributeList? _ Signature? _ Block ;

AdjustBlock ::= /ADJUST\b/ _ Block ;

PhaserBlock ::= /(?:BEGIN|END|INIT|CHECK|UNITCHECK)\b/ _ Block ;

TryCatchStatement ::= /try\b/ _ Block _ /catch\b/ _ /\(/ _ ScalarVariable _ /\)/ _ Block ;

# §10  ATTRIBUTES

AttributeList ::= WS Attribute
    | AttributeList WS Attribute ;

Attribute ::= /:/ _ QualifiedIdentifier
    | /:/ _ QualifiedIdentifier _ /\(/ _ QualifiedIdentifier _ /\)/ ;

# §11  SIGNATURES

Signature ::= /\(/ _ /\)/
    | /\(/ _ SignatureParams _ /\)/ ;

SignatureParams ::= SignatureParam
    | SignatureParams _ /,/ _ SignatureParam
    | SignatureParams _ /,/ ;

SignatureParam ::= ScalarSignatureParam
    | SlurpySignatureParam ;

ScalarSignatureParam ::= ScalarVariable
    | ScalarVariable _ /=/ _ Expression
    | /\$(?![\w{])/ ;

SlurpySignatureParam ::= ArrayVariable
    | HashVariable ;

# §12  EXPRESSIONS
# All operators at the same structural level. Precedence semiring resolves.

Expression ::= Atom
    | UnaryExpression
    | BinaryExpression
    | PostfixExpression
    | PreIncDec
    | TernaryExpression
    | AssignmentExpression
    | VariableDeclaration ;

ExpressionList ::= Expression
    | ExpressionList _ /,/ _ Expression
    | ExpressionList _ /=>/ _ Expression
    | ExpressionList _ /,/ ;

# §13  ATOMS

Atom ::= Variable
    | Literal
    | ParenExpr
    | ArrayConstructor
    | HashConstructor
    | QwLiteral
    | AnonymousSub
    | /__SUB__\b/
    | QualifiedIdentifier
    | CircumfixDeref ;

ParenExpr ::= /\(/ _ Expression _ /\)/
    | /\(/ _ ExpressionList _ /\)/
    | /\(/ _ /\)/ ;

ArrayConstructor ::= /\[/ _ ExpressionList? _ /\]/ ;

HashConstructor ::= /\{/ _ ExpressionList? _ /\}/ ;

AnonymousSub ::= /sub\b/ _ Signature? _ Block ;

QwLiteral ::= /qw\s*\([^)]*\)/ ;

# @{ EXPR } and %{ EXPR }: the aggregate EXPR refers to (EXPR->@*, EXPR->%*).
# The sigil and its brace are one token: `%{` after a term is still `%`
# then a HashConstructor, and nothing reads `@{^NAME}` as `@{` then `^NAME`.
CircumfixDeref ::= /@\{/ _ Expression _ /\}/
    | /%\{/ _ Expression _ /\}/ ;

# §14  UNARY EXPRESSIONS

UnaryExpression ::= /!/ _ Expression
    | /-[efdrwxRWXoOzslpSbcugktTBAMC]\b/ _ Expression
    | /-/ _ Expression
    | /\+/ _ Expression
    | /~/ _ Expression
    | /\\/ _ Expression
    | /not\b/ WS Expression ;

# §15  BINARY EXPRESSIONS
# Flat: all binary operators at one level. Precedence semiring resolves.

BinaryExpression ::= Expression _ BinaryOp _ Expression ;

BinaryOp ::= /\*\*/
    | /[*\/%]/
    | /x\b/
    | /[+-]/
    | /\.(?!\.)/
    | /<</
    | />>/
    | /<=>/
    | /[<>]=?/
    | /[!=]=/
    | /(?:eq|ne|lt|gt|le|ge|cmp)\b/
    | /=~/
    | /!~/
    | /&&/
    | /\|\|/
    | /\/\//
    | /\^\^/
    | /(?:and|or|xor)\b/
    | /&\./
    | /&(?!&)/
    | /\|\./
    | /\|(?!\|)/
    | /\^\./
    | /\^(?!\^)/
    | /\.\.\.?/
    | /isa\b/ ;

# §16  POSTFIX EXPRESSIONS

PostfixExpression ::= MethodCall
    | Subscript
    | PostfixDeref
    | CallExpression
    | PostfixIncDec ;

MethodCall ::= Expression _ /->/ _ QualifiedIdentifier _ /\(/ _ ExpressionList? _ /\)/
    | Expression _ /->/ _ QualifiedIdentifier
    | Expression _ /->/ _ ScalarVariable _ /\(/ _ ExpressionList? _ /\)/
    | Expression _ /->/ _ ScalarVariable ;

Subscript ::= Expression _ /->/ _ /\[/ _ Expression _ /\]/
    | Expression _ /->/ _ /\{/ _ Expression _ /\}/
    | Expression _ /->/ _ /\(/ _ ExpressionList? _ /\)/
    | Expression _ /\[/ _ Expression _ /\]/
    | Expression _ /\{/ _ Expression _ /\}/ ;

PostfixDeref ::= Expression _ /->/ _ /@\*/
    | Expression _ /->/ _ /%\*/
    | Expression _ /->/ _ /\$\*/
    | Expression _ /->/ _ /\$#\*/
    | Expression _ /->/ _ /@/ /\[/ _ ExpressionList _ /\]/
    | Expression _ /->/ _ /@/ /\{/ _ ExpressionList _ /\}/
    | Expression _ /->/ _ /%/ /\[/ _ ExpressionList _ /\]/
    | Expression _ /->/ _ /%/ /\{/ _ ExpressionList _ /\}/ ;
# Slices (alts 4-7): ->@[...] ->@{...} take the elements the list names,
# ->%[...] ->%{...} index/key-value pairs. The sigil and its bracket are one
# token to perl (`$r->@ [0]` is a syntax error), so no _ between them.

CallExpression ::= /(?!(?:print|printf|say)\b(?:\s|#[^\n]*)*\(?(?:\s|#[^\n]*)*\$(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)(?:\s|#[^\n]*)+(?:[\$\@"'`(\\~0-9]|![^=~]|[-+][^\s=]|\/[^\s\/=]|\.[0-9]|[%*&<][a-zA-Z_]|::[a-zA-Z_]|(?!(?:x|eq|ne|lt|gt|le|ge|cmp|isa|and|or|xor|if|unless|while|until|for|foreach)\b)[a-zA-Z_]))/ QualifiedIdentifier _ /\(/ _ ExpressionList? _ /\)/
    | /(?!(?:print|printf|say)\b(?:\s|#[^\n]*)*\(?(?:\s|#[^\n]*)*\$(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)(?:\s|#[^\n]*)+(?:[\$\@"'`(\\~0-9]|![^=~]|[-+][^\s=]|\/[^\s\/=]|\.[0-9]|[%*&<][a-zA-Z_]|::[a-zA-Z_]|(?!(?:x|eq|ne|lt|gt|le|ge|cmp|isa|and|or|xor|if|unless|while|until|for|foreach)\b)[a-zA-Z_]))/ QualifiedIdentifier WS ExpressionList
    | QualifiedIdentifier WS Block WS ExpressionList
    | QualifiedIdentifier WS Block
    | /(?:print|printf|say)\b/ WS IndirectHandle WS ExpressionList
    | /(?:print|printf|say)\b/ _ /\(/ _ IndirectHandle WS ExpressionList _ /\)/
    ;
# A filehandle as the indirect object of print, printf and say (alts 4-5;
# `print {EXPR} LIST` is alt 2's block form). perl 5.42 reads `print $name`
# followed by whitespace as the handle when what comes next starts a term --
# `$ @ " ' ` ( \ ~`, a digit, `!` not `!=`/`!~`, `-`/`+` not before a space
# or `=`, `/` not before a space, `/` or `=`, `.` before a digit,
# `% * & <` before a name, or a word that is not an infix or modifier
# keyword -- and as the first value otherwise: `print $x $y` vs
# `print $x - $y`. IndirectHandle states that test as a lookahead; the guard
# that opens alts 0-1 is its negation for print, printf and say, so a
# handle reading never also reads as a value (`print $x -1` is never
# `print($x - 1)`).

IndirectHandle ::= /(?=\$(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)(?:\s|#[^\n]*)+(?:[\$\@"'`(\\~0-9]|![^=~]|[-+][^\s=]|\/[^\s\/=]|\.[0-9]|[%*&<][a-zA-Z_]|::[a-zA-Z_]|(?!(?:x|eq|ne|lt|gt|le|ge|cmp|isa|and|or|xor|if|unless|while|until|for|foreach)\b)[a-zA-Z_]))/ ScalarVariable ;

PostfixIncDec ::= Expression _ /\+\+/
    | Expression _ /--/ ;

PreIncDec ::= /\+\+/ _ Expression
    | /--/ _ Expression ;

# §17  TERNARY AND ASSIGNMENT

TernaryExpression ::= Expression _ /\?/ _ Expression _ /:/ _ Expression ;

AssignmentExpression ::= Expression _ AssignOp _ Expression ;

AssignOp ::= /=(?![=>~])/
    | /\*\*=/
    | /[*\/%+\-&|^.]=/
    | /x=/
    | /&&=/
    | /\|\|=/
    | /\/\/=/
    | /<<=/
    | />>=/  ;

# §18  VARIABLES

Variable ::= ScalarVariable
    | ArrayVariable
    | HashVariable ;

# A variable name may be package-qualified ($Pkg::x, @Pkg::Sub::x) or name
# the main package by a leading :: ($::x). A trailing :: (a stash, %Pkg::)
# stays out: no symbol-table manipulation (spec section 2).

ScalarVariable ::= /\$(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)/
    | /\$\d+/
    | /\$\$[a-zA-Z_]\w*/
    | /\$#[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*/
    | /\$#\$[a-zA-Z_]\w*/
    | /\$#/ _ /\{/ _ Expression _ /\}/    # $#{EXPR}: array-length-of-deref
    | /\$(?:[@!\/\\.&?`'+|"%=\-~<>()\[\]]|:(?!:)|\^[A-Z]?|\{\^[A-Z_]\w*\}|#(?:[-+]|\{\^[A-Z_]\w*\}))/ ;
    # Punctuation variables, perlvar's whole set: $@ $! $/ $\ $. $& $? $`
    # $' $+ $| $" $% $= $- $~ $^ $: $< $> $( $) $[ $], the caret names $^W
    # and ${^NAME}, and the last indices $#- $#+ $#{^NAME}. Not $, $; $$:
    # they collide with the signature placeholder `($,)`, the statement
    # terminator and `$$ref`. ($0 is a digit variable, above.) `$:` is not
    # the head of `$::x`, nor `$^` of `$^W`: one token each, one reading.

ArrayVariable ::= /@(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)/
    | /@\$[a-zA-Z_]\w*/
    | /@(?:[-+]|\{\^[A-Z_]\w*\})/ ;
    # Punctuation arrays: @- @+ (match offsets) and @{^NAME}.

HashVariable ::= /%(?:[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*|(?:::[a-zA-Z_]\w*)+)/
    | /%\$[a-zA-Z_]\w*/
    | /%(?:[-+!]|\^H|\{\^[A-Z_]\w*\})/ ;
    # Punctuation hashes: %+ %- (named captures), %! (errno), %^H, %{^NAME}.

# §19  LITERALS

Literal ::= NumericLiteral
    | StringLiteral
    | RegexLiteral
    | /undef\b/
    | /true\b/
    | /false\b/ ;

NumericLiteral ::= /0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*/
    | /0[bB][01](?:_?[01])*/
    | /0[oO]?[0-7](?:_?[0-7])*/
    | /[0-9](?:_?[0-9])*(?:\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9]+)?/ ;

StringLiteral ::= /'(?:[^'\\]|\\.)*'/
    | /"(?:[^"\\]|\\.)*"/
    | /q\s*\{(?<B>(?:[^{}\\]|\\.|\{(?&B)\})*)\}/
    | /q\s*\[(?:[^\]\\]|\\.)*\]/
    | /q\s*\((?<P>(?:[^()\\]|\\.|\((?&P)\))*)\)/
    | /qq\s*\{(?<B>(?:[^{}\\]|\\.|\{(?&B)\})*)\}/
    | /qq\s*\[(?:[^\]\\]|\\.)*\]/
    | /qq\s*\((?<P>(?:[^()\\]|\\.|\((?&P)\))*)\)/
    | /`(?:[^`\\]|\\.)*`/
    | /qx\s*\((?:[^)\\]|\\.)*\)/
    | /qx\s*\{(?<B>(?:[^{}\\]|\\.|\{(?&B)\})*)\}/
    | /qx\s*\[(?:[^\]\\]|\\.)*\]/ ;
    # q{} qq{} qx{} (and m{} s{}{} below) nest their braces, as perl's do:
    # `q{a{b}c}` is a{b}c. (B is the brace-balanced body.)
    # q() and qq() nest their parens the same way: `q(a(b)c)` is a(b)c.
    # (P is the paren-balanced body.)
    # Backticks and qx(...) qx{...} qx[...] (alts 6-9) run a command: the
    # action builds a BacktickExpr over the command, interpolated as a
    # double-quoted string is. (No nested delimiters inside qx.)

RegexLiteral ::= /\/(?:[^\/\\\n]|\\.)*\/[msixpodualngcer]*/
    | /m\s*\/(?:[^\/\\]|\\.)*\/[msixpodualngcer]*/
    | /qr\s*\/(?:[^\/\\]|\\.)*\/[msixpodualngcer]*/
    | /s\s*\/(?:[^\/\\]|\\.)*\/(?:[^\/\\]|\\.)*\/[msixpodualngcer]*/
    | /s\s*\{(?<B>(?:[^{}\\]|\\.|\{(?&B)\})*)\}\s*\{(?&B)\}[msixpodualngcer]*/
    | /m\s*\{(?<B>(?:[^{}\\]|\\.|\{(?&B)\})*)\}[msixpodualngcer]*/
    | /tr\s*\/(?:[^\/\\]|\\.)*\/(?:[^\/\\]|\\.)*\/[cdsr]*/
    | /y\s*\/(?:[^\/\\]|\\.)*\/(?:[^\/\\]|\\.)*\/[cdsr]*/ ;

# §20  IDENTIFIERS AND HELPERS

QualifiedIdentifier ::= /[a-zA-Z_]\w*(?:::[a-zA-Z_]\w*)*/ ;

Block ::= /\{/ _ StatementList? _ /\}/
    | /\{/ _ StatementList? _ SimpleStatement _ /\}/ ;

Version ::= /v?[0-9]+(?:\.[0-9]+){2,}/ ;
