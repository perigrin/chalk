+    return $result;
+}
+
+# _sub_symbol('main::twice') -> 'main__twice'
+#
+# The symbol the sub-define loop emits, which builds it as
+# `'@' . $cname . '__' . $sname`. Kept as one function so the definition and
+# every call agree by construction rather than by two spellings that happen to
+# match.
+sub _sub_symbol {
+    my ($qualified) = @_;
+    my ($pkg, $sub) = $qualified =~ /^(.*)::([^:]+)$/
+        ? ($1, $2)
+        : ('main', $qualified);
+    return "${pkg}__${sub}";
+}
